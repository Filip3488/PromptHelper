# Copy this file to .streamlit/secrets.toml locally, or paste into
# Streamlit Cloud -> App settings -> Secrets. Do NOT commit real values.

MOTHERDUCK_TOKEN = "your-motherduck-token-here"

MD_DATABASE = "Prompts"
MD_TABLE = "prompts"

COL_ID = "id"
COL_TITLE = "title"
COL_CATEGORY = "category"
COL_CONTENT = "content"
COL_DESCRIPTION = "description"
COL_CREATED_AT = "created_at"
